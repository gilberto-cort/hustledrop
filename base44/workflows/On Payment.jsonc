{
  "description": "Verifies Stripe payments and refunds against Stripe before fulfilling the $19 Build My Business entitlement. Idempotent \u2014 replayed events never double-fulfill.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "on_payment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "verify_and_fulfill": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "handlePayment",
            "args": {
              "event_type": "${ .trigger.event_type }",
              "provider_transaction_id": "${ .trigger.provider_transaction_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Verify & fulfill purchase",
            "description": "Stripe-verified, idempotent"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "app_payment",
      "events": [
        "payment_succeeded",
        "payment_refunded"
      ]
    }
  },
  "name": "On Payment"
}