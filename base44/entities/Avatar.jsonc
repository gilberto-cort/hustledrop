{
  "name": "Avatar",
  "type": "object",
  "properties": {
    "dna_type": {
      "type": "string",
      "description": "DNA type this avatar represents"
    },
    "presentation": {
      "type": "string",
      "description": "Cosmetic presentation style (masculine / feminine)"
    },
    "sprite_asset": {
      "type": "string",
      "description": "Official pixel-art sprite URL (transparent PNG/WebP). Empty = labelled placeholder slot."
    },
    "display_name": {
      "type": "string",
      "description": "Display name for the avatar"
    },
    "level": {
      "type": "number",
      "default": 1,
      "description": "Cosmetic progression level (1=Explorer, 2=Founder, 3=Launcher, 4=Entrepreneur). Never affects scoring or matching."
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "dna_type",
    "display_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}