{
  "name": "CustomerWin",
  "type": "object",
  "properties": {
    "launch_quest_id": {
      "type": "string",
      "description": "LaunchQuest this win belongs to"
    },
    "offer_name": {
      "type": "string",
      "description": "Which offer was sold"
    },
    "sale_amount": {
      "type": "number",
      "description": "Optional sale amount (user-reported). Financial info is always optional."
    },
    "acquisition_channel": {
      "type": "string",
      "description": "Source of the customer (e.g. facebook_group, referral, in_person)"
    },
    "display_name": {
      "type": "string",
      "description": "Optional customer display name or alias (user-entered, never required)"
    },
    "repeat_customer": {
      "type": "boolean",
      "default": false,
      "description": "True when this is a repeat purchase by an existing customer"
    },
    "referral_source": {
      "type": "string",
      "description": "Optional \u2014 who referred this customer (recorded with the referrer's permission)"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes \u2014 what helped close the sale, feedback, etc."
    }
  },
  "required": [
    "launch_quest_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}