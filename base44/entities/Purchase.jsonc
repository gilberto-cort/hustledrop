{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id"
    },
    "product_key": {
      "type": "string",
      "description": "Identifier of the purchased product (build_my_business = $19 one-time Business Builder unlock for ONE selected business)"
    },
    "selected_business_id": {
      "type": "string",
      "description": "The SelectedBusiness this purchase unlocks. One purchase = one business build. NEVER blank for build_my_business purchases."
    },
    "amount": {
      "type": "number",
      "description": "Charged amount in the smallest unit"
    },
    "currency": {
      "type": "string",
      "description": "ISO currency code"
    },
    "payment_provider": {
      "type": "string",
      "description": "Provider used (stripe)"
    },
    "provider_checkout_id": {
      "type": "string",
      "description": "Stripe Checkout Session id (cs_...) this purchase was fulfilled from \u2014 the idempotency key for webhook + verify"
    },
    "provider_transaction_id": {
      "type": "string",
      "description": "Provider-side transaction reference (Stripe payment intent)"
    },
    "status": {
      "type": "string",
      "description": "pending = checkout started/processing; completed = PAID (verified server-side); failed; refunded",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ]
    }
  },
  "required": [
    "user_id",
    "product_key",
    "amount",
    "currency",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}