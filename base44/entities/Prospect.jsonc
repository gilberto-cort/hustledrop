{
  "name": "Prospect",
  "type": "object",
  "properties": {
    "launch_quest_id": {
      "type": "string",
      "description": "LaunchQuest this prospect belongs to"
    },
    "name_or_alias": {
      "type": "string",
      "description": "Prospect name or alias (user-entered)"
    },
    "channel": {
      "type": "string",
      "description": "Where the prospect was found / how they will be reached (e.g. facebook_group, linkedin, local_event, referral, other)"
    },
    "status": {
      "type": "string",
      "description": "Real-action ladder: prospect \u2192 contacted \u2192 conversation \u2192 followed_up \u2192 lead \u2192 customer (declined exits the ladder)",
      "enum": [
        "prospect",
        "contacted",
        "conversation",
        "followed_up",
        "lead",
        "customer",
        "declined"
      ],
      "default": "prospect"
    },
    "notes": {
      "type": "string",
      "description": "User notes about this prospect"
    }
  },
  "required": [
    "launch_quest_id",
    "name_or_alias"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}