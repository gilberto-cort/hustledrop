{
  "name": "QuizResponse",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id (blank for anonymous sessions)"
    },
    "session_id": {
      "type": "string",
      "description": "Quiz session id (anonymous or authenticated)"
    },
    "question_key": {
      "type": "string",
      "description": "Stable identifier for the quiz question"
    },
    "answer": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string"
      },
      "description": "Selected normalized answer value(s); array for multi-select questions"
    }
  },
  "required": [
    "session_id",
    "question_key",
    "answer"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}