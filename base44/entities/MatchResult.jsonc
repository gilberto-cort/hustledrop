{
  "name": "MatchResult",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id"
    },
    "profile_id": {
      "type": "string",
      "description": "HustleProfile used for this match run"
    },
    "business_model_id": {
      "type": "string",
      "description": "Matched BusinessModel id"
    },
    "rank": {
      "type": "number",
      "description": "Rank position in the result set (1-3)"
    },
    "personal_fit": {
      "type": "number",
      "description": "Compatibility with the user's stated circumstances, 1-99. NOT a probability of success."
    },
    "match_confidence": {
      "type": "number",
      "description": "How much useful information the user supplied, 40-100"
    },
    "score_breakdown": {
      "type": "object",
      "description": "Deterministic factor scores, base score, penalties, bonuses and unrounded fit",
      "additionalProperties": true
    },
    "positive_factors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Deterministic positive factor tokens"
    },
    "negative_factors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Deterministic negative factor tokens"
    },
    "tie_breaker_used": {
      "type": "string",
      "description": "Tie-breaker dimension applied, if any"
    },
    "tie_breaker_needed": {
      "type": "boolean",
      "default": false,
      "description": "True when #1 and #2 finished within 3 Personal Fit points"
    },
    "result_set_id": {
      "type": "string",
      "description": "Identifies one match run; rematches create a new set and preserve history"
    }
  },
  "required": [
    "user_id",
    "business_model_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}