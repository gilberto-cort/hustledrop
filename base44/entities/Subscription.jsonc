{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id"
    },
    "plan": {
      "type": "string",
      "description": "Subscription plan identifier"
    },
    "status": {
      "type": "string",
      "description": "Subscription status",
      "enum": [
        "active",
        "trialing",
        "past_due",
        "cancelled",
        "expired"
      ]
    },
    "provider_subscription_id": {
      "type": "string",
      "description": "Provider-side subscription reference"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "renewal_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "plan",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}