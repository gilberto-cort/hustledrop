{
  "name": "LaunchMission",
  "type": "object",
  "properties": {
    "launch_quest_id": {
      "type": "string",
      "description": "LaunchQuest this mission belongs to"
    },
    "mission_type": {
      "type": "string",
      "description": "Deterministic mission type (loadout, prospect_hunt, first_contact, conversations, follow_up, first_lead, first_customer)"
    },
    "title": {
      "type": "string",
      "description": "Mission display title"
    },
    "target_count": {
      "type": "number",
      "description": "Target count to complete the mission"
    },
    "current_count": {
      "type": "number",
      "default": 0,
      "description": "Measured real-action progress"
    },
    "xp_reward": {
      "type": "number",
      "default": 0,
      "description": "XP this mission contributes when completed"
    },
    "status": {
      "type": "string",
      "description": "locked = not yet reached; active = current mission; completed = target reached",
      "enum": [
        "locked",
        "active",
        "completed"
      ],
      "default": "locked"
    },
    "unlocked_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "launch_quest_id",
    "mission_type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}