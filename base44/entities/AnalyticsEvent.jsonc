{
  "name": "AnalyticsEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id (blank for anonymous events)"
    },
    "session_id": {
      "type": "string",
      "description": "Anonymous session id"
    },
    "event_name": {
      "type": "string",
      "description": "Event name from the supported event list"
    },
    "metadata": {
      "type": "object",
      "description": "Event metadata",
      "additionalProperties": true
    }
  },
  "required": [
    "event_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}